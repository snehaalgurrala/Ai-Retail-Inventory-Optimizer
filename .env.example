# Data access backend selection for the AI Retail Inventory Optimizer.
# "csv" (default) reads local CSVs; "oracle" reads from the BZ_MOCK_* schema.
DATA_BACKEND=csv

# Oracle connection settings (only used when DATA_BACKEND=oracle).
# Leave blank for CSV mode. Never commit real credentials.
ORACLE_USER=system
ORACLE_PASSWORD=Password@123
ORACLE_DSN=system@//localhost:1512/xe

# Optional connection pool sizing (defaults shown).
# ORACLE_POOL_MIN=1
# ORACLE_POOL_MAX=4

# Inventory scope for stock display/reasoning across the platform.
# "network" (default) sums stock across all branches; "branch" scopes per branch.
# (The Order Simulator always locks its own session to the customer's home
# branch regardless of this global value.)
# INVENTORY_SCOPE=network

# Set to 1/true to SUPPRESS order-pipeline alert emails (abnormal-order and
# low-stock) — all the analysis still runs, only the SMTP send is skipped.
# Useful for testing against a live SMTP server. Defaults to off (emails send).
# EMAIL_DRY_RUN=0
